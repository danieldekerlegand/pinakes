# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ralphy runtime state (regenerated each run)
.ralphy/

# Generated data — never committed. A corpus is regenerable from the category
# specs and is published as release artifacts instead (see docs/storage.md).
# `/out/*` (not `/out/`) so git can still descend into out/ to track the DVC
# pointer + DVC-managed .gitignore for the DVC-tracked pinakes-full build.
/out/*
!/out/pinakes-full.dvc
!/out/.gitignore
.http-cache/
