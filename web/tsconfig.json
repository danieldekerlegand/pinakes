{
  "include": ["src/**/*", "../contracts/**/*"],
  "exclude": [
    "../node_modules",
    "../build",
    "../dist",
    "../**/*.test.ts",
    "src/components/advanced-search-filters.tsx",
    "src/components/ai-translation-context.tsx",
    "src/components/database-normalizer.tsx",
    "src/components/language-evolution-timeline.tsx",
    "src/components/language-map.tsx",
    "src/components/user-contribution-panel.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["../contracts/*"]
    }
  }
}
