{
  "name": "pinakes",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "start": "uv run --all-packages python -m pinakes",
    "build": "vite build --config web/vite.config.ts",
    "dev:full": "./scripts/dev-full.sh",
    "graph:up": "./scripts/graph-up.sh",
    "sidecar:up": "docker compose -f infra/docker-compose.yml up -d --build pinakes_engine neo4j",
    "sidecar:down": "docker compose -f infra/docker-compose.yml stop pinakes_engine neo4j",
    "smoke:graph": "tsx scripts/smoke-graph.ts",
    "entity-grounding": "tsx scripts/export-entity-grounding.ts",
    "insimul-pack": "tsx scripts/export-insimul-pack.ts",
    "convergence-qa": "tsx scripts/convergence-qa.ts",
    "convergence-qa:baseline": "tsx scripts/convergence-qa.ts --write-baseline",
    "regen:registry-mirror": "tsx scripts/regen-registry-mirror.ts",
    "check:registry-mirror": "tsx scripts/regen-registry-mirror.ts --check",
    "gen:contracts": "tsx scripts/gen-contract-bindings.ts",
    "check:contracts": "tsx scripts/gen-contract-bindings.ts --check",
    "test": "vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "test:e2e:graph": "./scripts/e2e-graph.sh",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "secret-scan:staged": "tsx scripts/secret-scan.ts --staged",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "tsc -p web/tsconfig.json",
    "check:scripts": "tsc -p scripts/tsconfig.json"
  },
