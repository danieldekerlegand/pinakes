// curated-ancestor (curated)
rel ancestor(x, y) = descends_from(x, y)
rel ancestor(x, y) = descends_from(x, z) and ancestor(z, y)

// curated-component_of (curated)
rel component_of(x, y) = part_of(x, y)
rel component_of(x, y) = part_of(x, z) and component_of(z, y)

// curated-contemporary (curated)
rel contemporary(x, y) = time_start(x, sx) and time_end(x, ex) and time_start(y, sy) and time_end(y, ey) and ex >= sy and ey >= sx
rel contemporary(x, y) = contemporary_with(x, y)
rel contemporary(x, y) = contemporary_with(y, x)

// curated-follows (curated)
rel follows(x, y) = precedes(y, x)

// curated-genetic_linguistic_correlation (curated)
rel genetic_linguistic_correlation(x, y) = originates_from(x, r) and spoken_in(y, r)

// curated-influenced_transitively (curated)
rel influenced_transitively(x, y) = derived_from(x, y)
rel influenced_transitively(x, y) = influenced_by(x, y)
rel influenced_transitively(x, y) = derived_from(x, z) and influenced_transitively(z, y)
rel influenced_transitively(x, y) = influenced_by(x, z) and influenced_transitively(z, y)

// curated-instance_of (curated)
rel instance_of(x, c) = instance_of(x, d) and subclass_of(d, c)

// curated-precedes (curated)
rel precedes(x, y) = time_end(x, ex) and time_start(y, sy) and ex < sy

// curated-same_region (curated)
rel same_region(x, y) = within_region(x, r) and within_region(y, r)

// curated-within_region (curated)
rel within_region(x, y) = located_in(x, y)
