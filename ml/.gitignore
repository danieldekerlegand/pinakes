# uv-managed virtualenv
.venv/

# MLflow local file backend (experiment tracking store)
mlruns/
mlartifacts/

# setuptools build metadata (regenerated by editable installs)
*.egg-info/

# Python bytecode / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Regenerable build outputs — never committed (formerly DVC-pinned; see
# docs/artifact-versioning.md for how to re-introduce content versioning).
#   /data      ML datasets + trained embeddings
#   /artifacts QLoRA fine-tuning outputs (adapters / run summaries), reproducible
#              from the committed `configs/finetune-*.json` — see
#              docs/finetune-runbook.md
#   /models    deliverable model bundles (e.g. the slm-pilot GGUF)
/data
/artifacts
/models
