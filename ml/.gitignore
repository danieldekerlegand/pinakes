# uv-managed virtualenv
.venv/

# MLflow local file backend (experiment tracking store)
mlruns/
mlartifacts/

# ML datasets / trained artifacts under data/ are DVC-tracked, not git-tracked.
# DVC writes its own `data/.gitignore` on `dvc add`; the committed pointer is
# `ml/data.dvc`. (No manual ignore here so DVC owns that entry.)

# setuptools build metadata (regenerated by editable installs)
*.egg-info/

# Python bytecode / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
/data

# QLoRA fine-tuning outputs (adapters / run summaries) — reproducible from the
# committed config + DVC data, so not tracked (US-005). Committed inputs are
# `configs/finetune-*.json`; the runbook is `docs/finetune-runbook.md`.
/artifacts
/models
