# Copy to .env and fill in secrets. Existing application config:
# PORT is the one published port — the Pinakes service serves the client and /api on it
# (`npm start` → `python -m pinakes`; default 3050 when unset).
PORT=5000
# Gemini is called SERVER-SIDE ONLY (see docs/SECURITY.md). Never add a VITE_-prefixed
# Gemini key — Vite would bundle it into the client. All model calls go out from the
# Python service (e.g. POST /api/extract/text, /api/scraping/*) using GEMINI_API_KEY.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
# Google Translate is called SERVER-SIDE ONLY (see docs/SECURITY.md). The client proxies
# through POST /api/translate using this key. NEVER add a VITE_-prefixed translate key —
# Vite would bundle it into the client. (The old VITE_-prefixed translate key was REMOVED in US-002.)
GOOGLE_TRANSLATE_API_KEY=
MERRIAM_WEBSTER_API_KEY=

# ── pinakes-engine sidecar integration (ralph tasklists 15-16) ──
# Base URL of the pinakes-engine FastAPI sidecar (docker compose service `pinakes_engine`).
PINAKES_ENGINE_API_URL=http://localhost:8800
# Toggle graph features off without removing config (isAvailable() returns false
# when unset/falsey, so the app runs local-only with graph UI disabled).
PINAKES_ENGINE_ENABLED=true
# Per-request timeout for the sidecar HTTP client (pinakes.engine.corpus):
PINAKES_ENGINE_TIMEOUT_MS=10000
# Corpus the sidecar serves (path inside the sidecar container). Defaults to the
# bundled fixture; set to a mounted built corpus (e.g. out/<job>) for real data.
#
# The Python service (services/api) reads the SAME variable, in-process — it is
# the corpus its search/metrics/completeness/datalog calls read
# (services/api/src/pinakes/engine/corpus.py). Unset, it resolves to `build/corpus`
# under the repo root, which is where `pinakes_engine run jobs/*.yml` writes.
# Absent entirely, those calls answer 503 rather than failing (pinakes:50 US-1).
PINAKES_ENGINE_CORPUS=tests/fixtures/explorer-corpus

# ── Neo4j (shared correlation store) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pinakes
# docker compose reads NEO4J_AUTH for the neo4j container (must equal user/password above):
NEO4J_AUTH=neo4j/pinakes
# Optional graph-store driver tuning (pinakes.engine.graph); defaults shown:
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_MS=10000
NEO4J_CONNECTION_TIMEOUT_MS=5000
NEO4J_MAX_POOL_SIZE=50
# TTL (ms) for the cached /api/graph/status verdict (pinakes.routers.graph); default 5000:
GRAPH_HEALTH_TTL_MS=5000
# Truthy ⇒ POST /api/cross-domain/correlate serves graph-eligible domains from Neo4j
# (pinakes.analytics.correlation, US-007), falling back to the in-memory
# TSV path when the graph is down. Off by default:
CORRELATION_GRAPH_ENABLED=

# ── Place resolution (pinakes.search.places) ──
# GeoNames username for the preferred, standardized place geocoder (free signup at
# geonames.org — enable web services after registering). When unset, /api/map/places/*
# and /api/map/places/resolve transparently fall back to Nominatim (OpenStreetMap).
GEONAMES_USERNAME=

# ── Public contribution API auth + rate limiting (pinakes.contributions.auth, US-011) ──
# Comma-separated list of API keys accepted on contribution WRITE endpoints
# (POST /api/contributions, PATCH /api/contributions/:id/review). Each entry is
# `key` or `key:label` (the label is a non-secret display name). Clients present a
# key via the `X-API-Key` header or `Authorization: Bearer <key>`. When UNSET/empty,
# auth is DISABLED (writes are open — backward-compatible, works out-of-the-box);
# reads (GET /api/contributions*) are always open. Spec: GET /api/openapi.json.
CONTRIBUTION_API_KEYS=
# Fixed-window per-key rate limit for those writes (defaults: 60 requests / 60000 ms):
CONTRIBUTION_RATE_LIMIT_MAX=60
CONTRIBUTION_RATE_LIMIT_WINDOW_MS=60000
