# Copy to .env and fill in secrets. Existing application config:
DATABASE_URL=
NODE_ENV=development
PORT=5000
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
VITE_GOOGLE_TRANSLATE_API_KEY=
MERRIAM_WEBSTER_API_KEY=

# ── culture-scrape sidecar integration (ralph tasklists 15-16) ──
# Base URL of the culture-scrape FastAPI sidecar (docker compose service `culturescrape`).
CULTURESCRAPE_API_URL=http://localhost:8800
# Toggle graph features off without removing config.
CULTURESCRAPE_ENABLED=true
# Corpus the sidecar serves (path inside the sidecar container). Defaults to the
# bundled fixture; set to a mounted built corpus (e.g. out/<job>) for real data.
CULTURESCRAPE_CORPUS=tests/fixtures/explorer-corpus

# ── Neo4j (shared correlation store) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=linguascrape
# docker compose reads NEO4J_AUTH for the neo4j container (must equal user/password above):
NEO4J_AUTH=neo4j/linguascrape
# Optional graph-store driver tuning (server/services/graph-store.ts); defaults shown:
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_MS=10000
NEO4J_CONNECTION_TIMEOUT_MS=5000
NEO4J_MAX_POOL_SIZE=50
